# Copy this file to .env in the project root and set your private key below.
# .env is ignored by Git. Never commit or share your real key.
GEMINI_API_KEY=replace_with_your_api_key
# Optional: change the Gemini model when needed.
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated exact frontend origins. Keep only trusted origins in production.
FRONTEND_ORIGINS=http://localhost:5173
# Maximum uploaded notebook image size in bytes (default: 10 MiB).
MAX_UPLOAD_BYTES=10485760
